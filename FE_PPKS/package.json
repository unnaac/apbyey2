{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.7",
    "bootstrap": "^5.3.6"
  },
  "name": "fe_ppks",
  "version": "1.0.0",
  "main": "index.js",
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "http-server": "^14.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css",
